# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Required for the app to function ---

# DeepSeek API key (https://platform.deepseek.com/api_keys).
# Without it, /api/decode reaches DeepSeek with an empty key and every
# decode request fails at the LLM call.
DEEPSEEK_API_KEY=

# --- Required only for the eval cron + metrics dashboard ---

# Neon Postgres connection string. Only read by lib/db/evalStore.ts
# (the /api/cron/eval route and the /eval metrics dashboard). The core
# /api/decode route never touches a database.
DATABASE_URL=

# Bearer token that authorizes GET /api/cron/eval. Requests without a
# matching `Authorization: Bearer <CRON_SECRET>` header get a 401.
CRON_SECRET=

# --- Optional, have safe defaults ---

# Enables the in-memory per-domain LRU cache (lib/cache/domainCache.ts).
# Any value other than the literal string "true" leaves caching off.
ENABLE_CACHE=false

# Max requests per client IP per rate-limit window. Defaults to 5.
RATE_LIMIT_MAX=5

# Rate-limit window size in milliseconds. Defaults to 60000 (60s).
RATE_LIMIT_WINDOW_MS=60000

# Max number of distinct client identifiers (IP buckets) tracked at once.
# Defaults to 10000. Fail-closed: once this many active buckets exist, a
# request from a brand-new identifier is denied rather than allocating
# another bucket (existing identifiers are never evicted to make room).
# Bounds process memory against unbounded-cardinality attacks (many
# distinct spoofed/rotating IPs in one process lifetime).
RATE_LIMIT_MAX_BUCKETS=10000

# --- Test/eval-only, not read by application code ---

# Gates tests/eval/harness.test.ts, which makes real (billed) DeepSeek
# calls. The suite is skipped unless RUN_EVAL="true" AND DEEPSEEK_API_KEY
# is set. Leave unset in normal development and in CI.
RUN_EVAL=false
